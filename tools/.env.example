# goDTA direct connection, used when no --profile is given.
# Copy to .env (git-ignored) next to where godta runs, or pass --env <path>.
# A variable already set in the environment wins over this file.

# Instance: HOST, HOST,PORT, HOST\INSTANCE or HOST\INSTANCE,PORT. Empty = no direct connection.
GODTA_SERVER=
# Database to work in (optional).
GODTA_DATABASE=
# integrated, sql or entra.
GODTA_AUTH=
# Login, for auth=sql.
GODTA_USER=
# Free label, "lab" for a lab instance.
GODTA_ENVIRONMENT=
# readonly (default) or readwrite.
GODTA_MODE=
# true to accept a self-signed certificate.
GODTA_TRUST_SERVER_CERTIFICATE=

# Password for auth=sql. Keep it in the environment or in .env, never in a profile.
# GODTA_PASSWORD=
